# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="http://localhost:3000"

# PostgreSQL connection string for Vercel / Neon / Supabase / external deployments
# (Automatically takes precedence when set; SSL enabled for non-localhost hosts)
DATABASE_URL=""

# Cloud SQL PostgreSQL runtime variables (injected automatically by AI Studio Cloud SQL)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Razorpay Test Mode credentials (server-side ONLY — NEVER expose secrets in VITE_* vars)
# Key ID MUST start with rzp_test_. Live keys (rzp_live_) are explicitly rejected by the server.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Optional comma-separated list of emails granted admin role automatically on login/signup
ADMIN_EMAILS="pratham28may2007@gmail.com,admin@kovagoods.com"

# Optional server-side signing secret for local session tokens & sandbox payment signatures
# Defaults to a deterministic per-instance secret if unset in development
SESSION_SECRET=""
